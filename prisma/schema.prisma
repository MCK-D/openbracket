// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Necessary for Next auth
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? // @db.Text
  access_token             String? // @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? // @db.Text
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh_token_expires_in Int?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id             String     @id @default(cuid())
  name           String?
  email          String?    @unique
  emailVerified  DateTime?
  image          String?
  accounts       Account[]
  sessions       Session[]
  role           Role       @default(SPECTATOR)
  /// scrypt hash in the format produced by src/server/domain/passwords.ts; null for accounts without a password.
  passwordHash   String?
  /// Incremented to revoke every issued session of this user.
  sessionVersion Int        @default(0)
  auditLogs      AuditLog[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  ADMIN
  PLAYER
  SPECTATOR
}

enum TournamentFormat {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  ROUND_ROBIN
  SWISS
  FFA
}

enum TournamentStatus {
  DRAFT
  REGISTRATION
  LIVE
  COMPLETED
}

enum Visibility {
  PUBLIC
  INVITE_ONLY
}

model Tournament {
  id          String           @id @default(cuid())
  name        String
  game        String
  format      TournamentFormat
  status      TournamentStatus @default(DRAFT)
  visibility  Visibility       @default(PUBLIC)
  startsAt    DateTime
  sourceUrl   String?
  externalId  String?
  connectorId String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  matches     Match[]

  @@unique([connectorId, externalId])
  @@index([visibility, startsAt])
}

model Match {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round        Int
  homeName     String
  awayName     String
  homeScore    Int        @default(0)
  awayScore    Int        @default(0)
  startsAt     DateTime
  completedAt  DateTime?
  version      Int        @default(0)

  @@index([tournamentId, round])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  entityId  String
  createdAt DateTime @default(now())

  @@index([entityId, createdAt])
}
