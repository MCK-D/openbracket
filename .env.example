# PostgreSQL URL for host-based development. Docker Compose supplies its own internal URL.
DATABASE_URL="postgresql://openbracket:openbracket@localhost:55432/openbracket?schema=public"
# Same URL locally; use Neon's direct (non-pooler) URL for hosted migrations.
DATABASE_URL_UNPOOLED="postgresql://openbracket:openbracket@localhost:55432/openbracket?schema=public"
POSTGRES_PORT=55432
# Generate a unique value in every environment. npm run setup generates the local value.
AUTH_SECRET="replace-with-at-least-32-random-characters"
AUTH_URL="http://localhost:3000"
# Exposes only the synthetic spectator. Turn off when adding real authentication.
DEMO_AUTH_ENABLED="true"
# Never expose connector tokens using a NEXT_PUBLIC_ prefix.
START_GG_TOKEN=""
